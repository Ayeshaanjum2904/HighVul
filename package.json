{
	"name": "fidis-hub-front-staff",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"start": "react-app-rewired start",
		"build": "react-app-rewired --max_old_space_size=2048 build",
		"test": "react-app-rewired test",
		"lint": "eslint --ext .jsx,.js src/",
		"build:prod": "env-cmd .env.production yarn build",
		"build:dev": "env-cmd .env.development yarn build",
		"test:coverage": "set CI=true && yarn run test --coverage",
		"test:ci": "set CI=true && react-app-rewired test -u",
		"storybook": "start-storybook -p 6006 -s public",
		"build-storybook": "build-storybook -s public",
		"cypress": "cypress open",
		"cypress:all": "cypress run --e2e --browser electron",
		"prepare": "lefthook install"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"eslintConfig": {
		"extends": "react-app"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not op_mini all"
	],
